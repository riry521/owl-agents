{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owl.example.invalid/contracts/jsonschema/owl-v1/work-detail.json",
  "title": "WorkDetail",
  "type": "object",
  "required": [
    "id",
    "display_number",
    "title",
    "state",
    "state_version",
    "updated_at",
    "archived_at",
    "owner_id",
    "project_id",
    "summary",
    "size",
    "plan_revision",
    "progress",
    "conversation_id"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/ULID"
    },
    "display_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "state": {
      "$ref": "common.json#/$defs/WorkState"
    },
    "state_version": {
      "$ref": "common.json#/$defs/Version"
    },
    "updated_at": {
      "$ref": "common.json#/$defs/RFC3339"
    },
    "archived_at": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/RFC3339"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_id": {
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/ULID"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "size": {
      "$ref": "common.json#/$defs/WorkSize"
    },
    "plan_revision": {
      "$ref": "common.json#/$defs/Version"
    },
    "conversation_id": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/ULID"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "type": "object",
      "required": [
        "total_tasks",
        "completed_tasks",
        "percent"
      ],
      "properties": {
        "total_tasks": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of all Tasks associated with the Work."
        },
        "completed_tasks": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of Tasks whose status is completed."
        },
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Rounded completed_tasks / total_tasks percentage; 0 when there are no Tasks."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
