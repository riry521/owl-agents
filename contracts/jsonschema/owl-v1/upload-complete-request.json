    "sha256",
    "mime"
  ],
  "properties": {
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mime": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
