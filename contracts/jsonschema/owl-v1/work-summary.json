{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owl.example.invalid/contracts/jsonschema/owl-v1/work-summary.json",
  "title": "WorkSummary",
  "type": "object",
  "required": [
    "id",
    "display_number",
    "title",
    "state",
    "state_version",
    "updated_at",
    "project_id",
    "prerequisite_wait",
    "waiting_on"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/ULID"
    },
    "display_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "state": {
      "$ref": "common.json#/$defs/WorkState"
    },
    "state_version": {
      "$ref": "common.json#/$defs/Version"
    },
    "updated_at": {
      "$ref": "common.json#/$defs/RFC3339"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/ULID"
        },
        {
          "type": "null"
        }
      ]
    },
    "prerequisite_wait": {
      "type": "boolean"
    },
    "waiting_on": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/WorkPrerequisite" }
    }
  },
  "additionalProperties": false
}
