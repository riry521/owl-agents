# Owl-Agent environment configuration
# This file is copied to .env by setup.sh. Keep .env local and never commit it.
# CLI/setup language: ja or en. If unset, LC_ALL, LC_MESSAGES, then LANG decides.
# OWL_LANG=en

# --- AI Provider ---
# Safe offline default. Change to real only after installing/configuring a CLI.
OWL_PROVIDER=stub
# Model to use for AI roles (e.g. claude-sonnet-5, claude-opus-5)
OWL_PROVIDER_MODEL=claude-sonnet-5
# Optional real-provider selection (use an absolute executable path when set):
# OWL_PROVIDER_ADAPTER=claude-cli/v1
# OWL_PROVIDER_ADAPTER=codex-cli/v1
# OWL_PROVIDER_ID=anthropic
# OWL_CLAUDE_EXECUTABLE=/absolute/path/to/claude
# OWL_CODEX_EXECUTABLE=/absolute/path/to/codex

# --- Server ---
# OWL_PORT=3787
# OWL_BIND=127.0.0.1
# OWL_API_TOKEN=replace-with-a-long-random-token
# OWL_TAILSCALE_SERVE=1

# --- Durable data and identity ---
# OWL_DATA_DIR=./data
# OWL_OWNER_ID=owner:default
# Standalone single-provider startup accepts the legacy shared account id.
# --all requires both provider-specific account ids below.
# OWL_CONNECTOR_ACCOUNT_ID=01ARZ3NDEKTSV4RRFFQ69G5FAV
# OWL_SLACK_CONNECTOR_ACCOUNT_ID=01ARZ3NDEKTSV4RRFFQ69G5FAV
# OWL_DISCORD_CONNECTOR_ACCOUNT_ID=01ARZ3NDEKTSV4RRFFQ69G5FAV

# --- Slack Connector (optional) ---
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=...
# New installations can separate conversation and task notification channels.
# If omitted, the legacy SLACK_CHANNEL_ID is used for both.
# SLACK_CONVERSATION_CHANNEL_ID=C1234567890
# SLACK_NOTIFICATION_CHANNEL_ID=C0987654321
# SLACK_CHANNEL_ID=C1234567890

# --- Discord Connector (optional) ---
# DISCORD_BOT_TOKEN=...
# DISCORD_CONVERSATION_CHANNEL_ID=123456789012345678
# DISCORD_NOTIFICATION_CHANNEL_ID=987654321098765432
# DISCORD_CHANNEL_ID=123456789012345678
